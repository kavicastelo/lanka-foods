{
    "properties": {
        "order_id": {
            "type": "string",
            "description": "Order this item belongs to"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "menu_item_id": {
            "type": "string",
            "description": "MenuItem reference (nullable for deleted items)"
        },
        "name": {
            "type": "string",
            "description": "Dish name snapshot at order time"
        },
        "price": {
            "type": "number",
            "description": "Price snapshot at order time (server-verified from MenuItem)"
        },
        "quantity": {
            "type": "number",
            "description": "Quantity ordered"
        },
        "instructions": {
            "type": "string",
            "description": "Per-item special instructions"
        },
        "customer_id": {
            "type": "string",
            "description": "Denormalized customer ID for RLS ownership"
        },
        "restaurant_id": {
            "type": "string",
            "description": "Denormalized restaurant ID for RLS ownership"
        }
    },
    "required": [
        "order_id",
        "name",
        "price",
        "quantity"
    ],
    "name": "OrderItem",
    "type": "object",
    "rls": {
        "read": {
            "$or": [
                {
                    "data.customer_id": "{{user.id}}"
                },
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "$or": [
                {
                    "data.customer_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}