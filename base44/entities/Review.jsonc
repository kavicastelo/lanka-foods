{
    "properties": {
        "restaurant_id": {
            "type": "string",
            "description": "Restaurant being reviewed"
        },
        "order_id": {
            "type": "string",
            "description": "Order this review is for (one review per order)"
        },
        "author_id": {
            "type": "string",
            "description": "User ID of the reviewer"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "author_name": {
            "type": "string",
            "description": "Denormalized author name"
        },
        "rating": {
            "type": "number",
            "description": "Overall rating 1-5"
        },
        "food_rating": {
            "type": "number",
            "description": "Food rating 1-5"
        },
        "text": {
            "type": "string",
            "description": "Review text"
        },
        "is_verified": {
            "type": "boolean",
            "description": "True if linked to a completed order"
        }
    },
    "required": [
        "restaurant_id",
        "order_id",
        "author_id",
        "rating"
    ],
    "name": "Review",
    "type": "object",
    "rls": {
        "read": {},
        "create": {
            "$or": [
                {
                    "data.author_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "user_condition": {
                "role": "admin"
            }
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}