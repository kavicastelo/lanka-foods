{
    "properties": {
        "order_number": {
            "type": "string",
            "description": "Human-readable order number e.g. LE-10231"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "restaurant_id": {
            "type": "string",
            "description": "Restaurant receiving the order"
        },
        "customer_id": {
            "type": "string",
            "description": "User ID of the customer (set server-side from session)"
        },
        "customer_name": {
            "type": "string",
            "description": "Denormalized customer name"
        },
        "customer_phone": {
            "type": "string",
            "description": "Denormalized customer phone"
        },
        "customer_email": {
            "type": "string",
            "description": "Denormalized customer email"
        },
        "delivery_type": {
            "type": "string",
            "enum": [
                "pickup",
                "delivery"
            ],
            "description": "Pickup or delivery"
        },
        "status": {
            "type": "string",
            "enum": [
                "received",
                "accepted",
                "preparing",
                "ready",
                "out_for_delivery",
                "completed",
                "cancelled",
                "rejected"
            ],
            "description": "Order lifecycle status"
        },
        "subtotal": {
            "type": "number",
            "description": "Subtotal in euros (server-calculated)"
        },
        "delivery_fee": {
            "type": "number",
            "description": "Delivery fee in euros"
        },
        "service_fee": {
            "type": "number",
            "description": "Service fee in euros"
        },
        "total": {
            "type": "number",
            "description": "Total in euros (server-calculated)"
        },
        "scheduled_date": {
            "type": "string",
            "description": "Requested date"
        },
        "scheduled_time": {
            "type": "string",
            "description": "Requested time slot or ASAP"
        },
        "delivery_address": {
            "type": "string",
            "description": "Delivery address (if delivery)"
        },
        "instructions": {
            "type": "string",
            "description": "Special instructions"
        },
        "payment_method": {
            "type": "string",
            "enum": [
                "card",
                "mobile",
                "pickup"
            ],
            "description": "Informational payment method (no processing in Phase 1)"
        },
        "payment_status": {
            "type": "string",
            "enum": [
                "pending",
                "paid",
                "refunded",
                "failed"
            ],
            "description": "Payment status (stays pending until future payment system)"
        },
        "placed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the order was placed"
        }
    },
    "required": [
        "order_number",
        "restaurant_id",
        "customer_id",
        "delivery_type",
        "status",
        "total"
    ],
    "name": "Order",
    "type": "object",
    "rls": {
        "read": {
            "$or": [
                {
                    "data.customer_id": "{{user.id}}"
                },
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "$or": [
                {
                    "data.customer_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}