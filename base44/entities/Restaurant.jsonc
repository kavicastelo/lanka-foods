{
    "properties": {
        "name": {
            "type": "string",
            "description": "Restaurant name"
        },
        "slug": {
            "type": "string",
            "description": "URL-safe unique slug"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "owner_id": {
            "type": "string",
            "description": "User ID of the restaurant owner"
        },
        "city": {
            "type": "string",
            "description": "City/municipality"
        },
        "address": {
            "type": "string",
            "description": "Street address"
        },
        "phone": {
            "type": "string",
            "description": "Restaurant phone"
        },
        "email": {
            "type": "string",
            "description": "Restaurant contact email"
        },
        "cover_image_url": {
            "type": "string",
            "description": "Cover image URL"
        },
        "logo_text": {
            "type": "string",
            "description": "2-letter logo abbreviation"
        },
        "description": {
            "type": "string",
            "description": "Restaurant description"
        },
        "cuisines": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Cuisine tags"
        },
        "price_range": {
            "type": "string",
            "description": "Price range e.g. \u20ac, \u20ac\u20ac, \u20ac\u20ac\u20ac"
        },
        "prep_time": {
            "type": "string",
            "description": "Preparation time estimate"
        },
        "min_order": {
            "type": "number",
            "description": "Minimum order value in euros"
        },
        "delivery_fee": {
            "type": "number",
            "description": "Delivery fee in euros"
        },
        "pickup": {
            "type": "boolean",
            "description": "Pickup available"
        },
        "delivery": {
            "type": "boolean",
            "description": "Delivery available"
        },
        "halal": {
            "type": "boolean",
            "description": "Halal certified"
        },
        "catering": {
            "type": "boolean",
            "description": "Catering available"
        },
        "is_open": {
            "type": "boolean",
            "description": "Currently open/accepting orders"
        },
        "hours": {
            "type": "string",
            "description": "Opening hours description"
        },
        "time_slots": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Available time slots"
        },
        "featured": {
            "type": "boolean",
            "description": "Featured on homepage"
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "active",
                "suspended",
                "rejected",
                "changes_requested"
            ],
            "description": "Restaurant lifecycle status"
        },
        "commission_rate": {
            "type": "number",
            "description": "Per-restaurant commission override (null = use platform default)"
        }
    },
    "required": [
        "name",
        "slug",
        "owner_id",
        "city",
        "status"
    ],
    "name": "Restaurant",
    "type": "object",
    "rls": {
        "read": {
            "$or": [
                {
                    "data.status": "active"
                },
                {
                    "data.owner_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "user_condition": {
                "role": "admin"
            }
        },
        "update": {
            "$or": [
                {
                    "data.owner_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}