{
    "properties": {
        "business_name": {
            "type": "string",
            "description": "Proposed restaurant name"
        },
        "owner_name": {
            "type": "string",
            "description": "Owner contact name"
        },
        "email": {
            "type": "string",
            "description": "Contact email"
        },
        "phone": {
            "type": "string",
            "description": "Contact phone"
        },
        "city": {
            "type": "string",
            "description": "City/municipality"
        },
        "address": {
            "type": "string",
            "description": "Street address"
        },
        "business_type": {
            "type": "string",
            "description": "Type of food business"
        },
        "cuisine": {
            "type": "string",
            "description": "Cuisine description (comma list)"
        },
        "description": {
            "type": "string",
            "description": "Business description"
        },
        "pickup": {
            "type": "boolean",
            "description": "Pickup available"
        },
        "delivery": {
            "type": "boolean",
            "description": "Delivery available"
        },
        "logo_url": {
            "type": "string",
            "description": "Uploaded logo URL"
        },
        "cover_url": {
            "type": "string",
            "description": "Uploaded cover image URL"
        },
        "status": {
            "type": "string",
            "enum": [
                "pending",
                "changes_requested",
                "approved",
                "rejected"
            ],
            "description": "Application status"
        },
        "submitted_date": {
            "type": "string",
            "format": "date",
            "description": "Date submitted"
        },
        "applicant_user_id": {
            "type": "string",
            "description": "User ID of the applicant"
        }
    },
    "required": [
        "business_name",
        "owner_name",
        "email",
        "status",
        "applicant_user_id"
    ],
    "name": "RestaurantApplication",
    "type": "object",
    "rls": {
        "read": {
            "$or": [
                {
                    "data.applicant_user_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "$or": [
                {
                    "data.applicant_user_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "user_condition": {
                "role": "admin"
            }
        },
        "delete": {
            "user_condition": {
                "role": "admin"
            }
        }
    }
}