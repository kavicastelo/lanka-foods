{
    "properties": {
        "role": {
            "type": "string",
            "description": "Platform role. 'admin' maps to SUPER_ADMIN marketplace role (platform administrator). 'user' is a standard user whose marketplace role (RESTAURANT_ADMIN or CUSTOMER) is determined by restaurant ownership, not by this field.",
            "enum": [
                "admin",
                "user"
            ]
        },
        "phone": {
            "type": "string",
            "description": "User phone number"
        },
        "restaurant_id": {
            "type": "string",
            "description": "ID of the Restaurant this user owns. Set by the restaurant-application approval backend function, not by the client. Used for RLS convenience on menu/order entities; actual data access is enforced by Restaurant.owner_id checks."
        }
    },
    "required": [
        "role"
    ],
    "name": "User",
    "type": "object"
}