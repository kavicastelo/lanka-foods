{
    "properties": {
        "user_id": {
            "type": "string",
            "description": "User who favorited"
        },
        "restaurant_id": {
            "type": "string",
            "description": "Favorited restaurant (nullable if menu_item_id is set)"
        },
        "menu_item_id": {
            "type": "string",
            "description": "Favorited menu item (nullable if restaurant_id is set)"
        }
    },
    "required": [
        "user_id"
    ],
    "name": "Favorite",
    "type": "object",
    "rls": {
        "read": {
            "$or": [
                {
                    "data.user_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "data.user_id": "{{user.id}}"
        },
        "update": {
            "data.user_id": "{{user.id}}"
        },
        "delete": {
            "$or": [
                {
                    "data.user_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        }
    }
}