{
    "properties": {
        "restaurant_id": {
            "type": "string",
            "description": "Restaurant this item belongs to"
        },
        "category_id": {
            "type": "string",
            "description": "MenuCategory this item belongs to"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "name": {
            "type": "string",
            "description": "Dish name"
        },
        "description": {
            "type": "string",
            "description": "Dish description"
        },
        "price": {
            "type": "number",
            "description": "Price in euros (must be positive, server-authoritative for orders)"
        },
        "image_url": {
            "type": "string",
            "description": "Dish image URL"
        },
        "is_vegetarian": {
            "type": "boolean",
            "description": "Vegetarian"
        },
        "is_available": {
            "type": "boolean",
            "description": "Available for ordering"
        },
        "is_popular": {
            "type": "boolean",
            "description": "Marked as popular choice"
        },
        "sort_order": {
            "type": "number",
            "description": "Display sort order"
        }
    },
    "required": [
        "restaurant_id",
        "category_id",
        "name",
        "price"
    ],
    "name": "MenuItem",
    "type": "object",
    "rls": {
        "read": {},
        "create": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        }
    }
}