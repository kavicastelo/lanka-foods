{
    "properties": {
        "restaurant_id": {
            "type": "string",
            "description": "Restaurant this category belongs to"
        },
        "legacy_id": {
            "type": "string",
            "description": "Legacy ID from prototype data for idempotent migration"
        },
        "name": {
            "type": "string",
            "description": "Menu section name e.g. Rice & Curry"
        },
        "sort_order": {
            "type": "number",
            "description": "Display sort order"
        }
    },
    "required": [
        "restaurant_id",
        "name"
    ],
    "name": "MenuCategory",
    "type": "object",
    "rls": {
        "read": {},
        "create": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "update": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "$or": [
                {
                    "data.restaurant_id": "{{user.data.restaurant_id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        }
    }
}